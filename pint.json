{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "array_syntax": {
            "syntax": "short"
        },
        "ordered_imports": true,
        "no_unused_imports": true,
        "single_trait_insert_per_statement": true,
        "no_extra_blank_lines": true
    },
    "exclude": [
        "storage",
        "bootstrap/cache"
    ]
}
